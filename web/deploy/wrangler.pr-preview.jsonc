// Temporary, untracked: PR #8 review preview. Separate Worker, no routes; same MODELS binding as koelony-demo.
{
  "name": "koelony-demo-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/models/*", "/ort/*.wasm", "/blog", "/blog/*"] },
  "services": [{ "binding": "MODELS", "service": "koelony-demo-models" }],
  "vars": { "ORT_VERSION": "1.31.1" },
  "workers_dev": true,
  "preview_urls": false
}
